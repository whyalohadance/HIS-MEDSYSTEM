# ============================================
# HIS-MedSystem Configuration
# ============================================
# Скопируй в .env и измени значения:
#   cp .env.example .env

# ============ ENVIRONMENT ============
NODE_ENV=production
TZ=Europe/Chisinau

# ============ PORTS ============
FRONTEND_PORT=80
BACKEND_PORT=3000
DB_PORT=5432
PGADMIN_PORT=5050

# ============ DATABASE ============
DB_DATABASE=medical_db
DB_USERNAME=medical_user
DB_PASSWORD=medical123
DB_SYNCHRONIZE=false

# ============ JWT ============
# ВАЖНО: замени на случайную строку минимум 32 символа!
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-this-to-random-string-min-32-characters-very-important-secret
JWT_EXPIRES_IN=7d

# ============ FRONTEND ============
FRONTEND_URL=http://localhost

# ============ SEED DATA ============
# true = при запуске создаст тестовые аккаунты (только если таблица пустая)
RUN_SEED=true

# ============ PGADMIN (опционально) ============
PGADMIN_EMAIL=admin@his.local
PGADMIN_PASSWORD=admin
